1.Find the cheapest book of SIBM library.
Select i.Lname as Institute,b.Bname as Book from ILibrary i,Books b
    -> where b.Lid = i.Lid and 
    -> b.Price = (select Min(b.Price) from Books b, ILibrary i 
    -> where b.Lid=i.Lid and i.Lname = 'SIBMLib');

2.Which library has the costliest book?
Select i.Lname as Institute,b.Bname as Book from ILibrary i,Books b
    -> where b.Lid = i.Lid and b.Price = (Select Max(Price) from Books);

3.How many students from SIT issued the book?
Select d.Institute_name as Institute,Count(i.Memid) as NoofStudents from Issue i,Department d,Member m
    -> where m.Memid=i.Memid and m.Lid=d.Lid and d.Lid=i.Lid and d.Institute_name ='SIT';

4.What is the average cost of books in SITMN
Select d.Institute_name as Institute,Count(i.Memid) as NoofStudents from Issue i,Department d,Member m
    -> where m.Memid=i.Memid and m.Lid=d.Lid and d.Lid=i.Lid and d.Institute_name ='SIT';

5.What is the total cost of purchase made by SIT in the month of January to June?
select sum(p.totalcost) as TotalCost,b.Bname as Book,i.Lname as Institute  from Purchase p,Books b,ILibrary i
    -> where p.Bid =b.Bid and i.Lid =p.Lid and i.Lname='SITLib' and month(p.date) between 1 and 6 group by 2,3;

6.How many books are written by “Shruti”
Select a.Aname as Name,Count(b.Bname) as NoofBooks from Books b,Author a,Writes w
    -> where w.Aid=a.Aid and w.Bid=b.Bid and a.Aname='Shruti';

7.What is the costliest book published by “Pragati Book Store”
 Select p.Pname,Max(b.Price) from Publisher p,Books b,Writes w
    -> where w.Pid=p.Pid and b.Bid=w.Bid and p.Pname='Pragati Book Store';
